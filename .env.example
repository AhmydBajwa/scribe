NODE_ENV=development
USE_MOCK_ATHENA=false
ATHENAHEALTH_BASE_URL=https://your-athena-endpoint.example
ATHENAHEALTH_CLIENT_ID=replace-with-athena-client-id
ATHENAHEALTH_CLIENT_SECRET=replace-with-athena-client-secret
ATHENAHEALTH_SCOPE=replace-with-athena-scope
ATHENAHEALTH_PRACTICE_ID=replace-with-athena-practice-id
ATHENAHEALTH_APPOINTMENTS_PATH=/appointments

# Production (Render) runtime configuration
# APP_BASE_URL=https://your-scribel-service.onrender.com
# SCRIBEL_DATA_DIR=/var/data
# SAML_IDP_PRIVATE_KEY_B64=base64-encoded-private-key-pem
# SAML_IDP_CERT_B64=base64-encoded-certificate-pem
# SCRIBEL_USERS_JSON=[{"email":"provider@example.com","password":"replace-this","name":"Provider","role":"Care Coordinator","organization":"Scribel"}]

# Local CPU transcription and speaker diarization. No OpenAI API key/billing is used.
TRANSCRIPTION_PROVIDER=local-whisper
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_UPLOAD_MB=50
MAX_AUDIO_DURATION_MINUTES=60
DIARIZATION_PROVIDER=pyannote
PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Optional: only set when the exact speaker count is known, e.g. 2 for a one-to-one visit.
# DIARIZATION_NUM_SPEAKERS=2
# Accept the model terms on Hugging Face, then create a read token for the first model download.
# Inference subsequently runs locally on CPU.
# HF_TOKEN=
# Tests can use deterministic local mocks without downloading models:
# TRANSCRIPTION_PROVIDER=mock
# DIARIZATION_PROVIDER=mock
